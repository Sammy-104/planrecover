# Set these in private Vercel settings; never commit their values.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
BLOB_READ_WRITE_TOKEN=

# Hosting flags are supplied by vercel.json and build:vercel.
# Optional exact HTTPS origins, comma-separated, for additional custom domains:
CLERK_AUTHORIZED_PARTIES=

# Existing AWS/PayPal/email settings remain optional and server-only.
# See server.env.example and adapters.env.example. No scheduled jobs are enabled.
