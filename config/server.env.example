# Names only. Configure values in private runtime settings, never commit keys.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
JOB_RUNNER_KEY=
JOB_BATCH_SIZE=25
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=ca-central-1
BEDROCK_MODEL_ID=
BEDROCK_REQUIRE_APPLICATION_PROFILE=true
# Optional reviewed Canadian Nova Lite pricing. Set both after verifying the actual profile;
# see docs/BEDROCK_PRICING_2026-10-19.md. Blank means no cost estimate, not free inference.
BEDROCK_PRICING_PRESET=
BEDROCK_PRICING_MODEL_SHA256=
# Optional pre-existing receipt provider fallback:
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional provider adapters are listed in adapters.env.example.
# Optional Amazon SES reminder email. Disabled until explicitly enabled.
# Dedicated ses:SendEmail credentials only; never use the Bedrock bearer token.
AWS_SES_ENABLED=false
AWS_SES_REGION=ca-central-1
AWS_SES_FROM_EMAIL=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_SESSION_TOKEN=
AWS_SES_CONFIGURATION_SET=
# SES outcome ingestion is independent of sending. Requires an exact SNS topic,
# signature version 2, and deliberate ingress setup; never make this Site public.
AWS_SES_EVENTS_ENABLED=false
AWS_SES_EVENTS_TOPIC_ARN=
# Standard browser Web Push. Dedicated VAPID keys; generating/configuring keys
# does not enable sending. Contact must be a mailto: address.
WEB_PUSH_ENABLED=false
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
