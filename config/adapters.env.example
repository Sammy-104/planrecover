# Names only. Enter real values through private server settings, never commit them.
# All optional external adapters remain disabled without configuration.
SUPPLIER_ORIGIN=
SUPPLIER_TOKEN=
SUPPLIER_MODE=sandbox
SUPPLIER_BOOKING_ENABLED=false
NOTIFICATION_ORIGIN=
NOTIFICATION_TOKEN=
AWS_ADAPTERS_ENABLED=false
AWS_ADAPTER_ACCESS_KEY_ID=
AWS_ADAPTER_SECRET_ACCESS_KEY=
AWS_ADAPTER_SESSION_TOKEN=
# Optional receipt override; default uses the existing Bedrock/manual path.
RECEIPT_EXTRACTION_PROVIDER=
STEP_FUNCTIONS_STATE_MACHINE_ARN=
STEP_FUNCTIONS_ACTIVITY_ARN=
WORKFLOW_TOKEN_KEY=
# Separate public relay runtime, not the private Site environment:
# Use services/paypal-relay/README.md and its wrangler.json only; infrastructure/paypal-relay is a legacy fixture.
